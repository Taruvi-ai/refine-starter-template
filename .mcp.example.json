{
  "mcpServers": {
    "taruvi": {
        "type": "http",
        "url": "https://tenant.taruvibase.cloud/mcp/",
        "headers":{
          "Authorization": "Api-Key YOUR_TARUVI_API_KEY",
          "X-App-Slug": "sample-app"
        }
    },
    "context7": {
            "command": "npx",
            "args": ["-y", "@upstash/context7-mcp", "--api-key", "YOUR_CONTEXT7_API_KEY"]
    }
  }
}
